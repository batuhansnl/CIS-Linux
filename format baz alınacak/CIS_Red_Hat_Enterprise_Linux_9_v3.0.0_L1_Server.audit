      sed -ri '/^\\s*\\[org\\/gnome\\/login-screen\\]/a banner-message-text='\"$l_banner\"'' \"$l_file\"
   else
      printf '%s\\n' \"\" \"${a_keyfile[@]}\" >> \"$l_file\"
   fi
}

