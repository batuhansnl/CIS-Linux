  done
  [ \"${#a_output[@]}\" -gt \"0\" ] && printf '%s\\n' \"\" \"${a_output[@]}\" \"\"
  } | /bin/awk 'NR == 2 { if (/net.ipv6.conf.default.accept_ra = 0\" is set/) { print \"Pass\" } else { print \"Fail\" } } { print }'"
