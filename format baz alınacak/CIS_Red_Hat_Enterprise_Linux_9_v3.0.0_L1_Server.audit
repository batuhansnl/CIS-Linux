#!/usr/bin/env bash

{
   f_key_file_fix()
   {
      while IFS= read -r -d $'\\0' l_file; do
         grep -Psiq -- \"^\\h*$l_parameter\\h+$l_value(\\b|\\h*$)\" \"$l_file\" && \\
         sed -ri '/^\\s*'\"$l_parameter\"'/s/^/# /g' \"$l_file\"
      done < <(find /etc/dconf/db -mindepth 2 -maxdepth 2 -type f -print0)
