          cmd         : "#!/bin/bash

{
   l_ssh_group=\"\"
   grep -Psiq -- '^\\h*ID_LIKE=\"?([^#\\n\\r]+)?\\bfedora\\b' /etc/os-release 2>/dev/null && \\
      grep -Psq -- '^ssh_keys\\b' /etc/group 2>/dev/null && l_ssh_group=\"ssh_keys\"
   while IFS= read -r l_key; do
      l_file=\"${l_key}.pub\"
      ssh-keygen -lf \"$l_file\" &>/dev/null || continue
      while IFS=: read -r l_mode l_owner l_group; do
         if [ $(( l_mode & 0133 )) -gt 0 ] || [ \"$l_owner\" != \"root\" ] || \\
            { [ \"$l_group\" != \"$l_ssh_group\" ] && [ \"$l_group\" != \"root\" ]; }; then
            printf '%s\\n' \"\\\"$l_file\\\": mode $l_mode owner $l_owner group $l_group\"
         fi
      done < <(stat -Lc '%#a:%U:%G' \"$l_file\")
   done < <(sshd -T 2>/dev/null | awk '$1==\"hostkey\"{print $2}')
} | /bin/awk '{ print } END { if (NR == 0) print \"pass\" }'"
          expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "5.1.4 Ensure access to SSH public host key files is configured"
          info        : "An SSH public key is one of two files used in SSH public key authentication. In this authentication method, a public key is a key that can be used for verifying digital signatures generated using a corresponding private key. Only a public key that corresponds to a private key will be able to authenticate successfully.

If a public host key file is modified by an unauthorized user, the SSH service may be compromised."
          solution    : "Run the following script to set the owner, group, and restrict permissions on each SSH public host key file from the running sshd configuration:

#!/usr/bin/env bash
{
   while IFS= read -r l_key; do
      l_file=\"${l_key}.pub\"
      [ -e \"$l_file\" ] || continue
      chown root:root \"$l_file\"
      chmod u-x,go-wx \"$l_file\"
   done < <(sshd -T 2>/dev/null | awk '$1==\"hostkey\"{print $2}')
}

Impact:

Public host key files are intended to be readable; enforcing mode 0644, owner and group root, only removes excess write and execute permissions and does not affect normal SSH operation."
