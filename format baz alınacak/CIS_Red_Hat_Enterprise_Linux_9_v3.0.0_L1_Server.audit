      cmd         : "#!/bin/bash

{
   while IFS= read -r l_mount; do
      find \"$l_mount\" -xdev -type f \\( -perm -4000 -o -perm -2000 \\) -printf '%M %p\n' 2>/dev/null
   done < <(findmnt -Dkerno fstype,target,options | awk '($1 !~ /^[[:space:]]*(nfs|proc|smb|vfat|iso9660|efivarfs|selinuxfs)/ && $2 !~ /^\\/run\\/user\\// && $3 !~ /noexec/ && $3 !~ /nosuid/){print $2}')
}"
      expect      : "^Manual Review Required$"
      severity    : MEDIUM
