[ -n \"$l_option_value\" ] && \\
a_output+=(\" - \\\"$l_parameter_name = $l_option_value\\\" is set in: \\\"$l_file\\\"\")
done
[ \"${#a_output[@]}\" -gt \"0\" ] && printf '%s\\n' \"\" \"${a_output[@]}\" \"\"
