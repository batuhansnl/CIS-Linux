      cmd         : "#!/bin/bash
  {
  l_floor=$(( 8#0027 ))

  f_umask_to_dec() {
  local l_arg l_u l_g l_o l_clause l_who l_perms l_bits l_deny
  l_arg=\"$1\"
  l_u=0
  l_g=0
  l_o=0
  if [[ \"$l_arg\" =~ ^[0-7]{3,4}$ ]]; then
  printf '%d' \"$(( 8#$l_arg ))\"; return 0
  fi
  local IFS=','
  local l_clauses
  read -r -a l_clauses <<< \"$l_arg\"
  for l_clause in \"${l_clauses[@]}\"; do
  if [[ \"$l_clause\" =~ ^([augo]+)=([rwx]*)$ ]]; then
  l_who=\"${BASH_REMATCH[1]}\"; l_perms=\"${BASH_REMATCH[2]}\"; l_bits=0
  [[ \"$l_perms\" == *r* ]] && l_bits=$(( l_bits | 4 ))
  [[ \"$l_perms\" == *w* ]] && l_bits=$(( l_bits | 2 ))
  [[ \"$l_perms\" == *x* ]] && l_bits=$(( l_bits | 1 ))
  l_deny=$(( 7 - l_bits ))
  [[ \"$l_who\" == *a* ]] && { l_u=$l_deny; l_g=$l_deny; l_o=$l_deny; }
  [[ \"$l_who\" == *u* ]] && l_u=$l_deny
  [[ \"$l_who\" == *g* ]] && l_g=$l_deny
  [[ \"$l_who\" == *o* ]] && l_o=$l_deny
  else
  printf 'INVALID'; return 0
  fi
  done
  printf '%d' \"$(( l_u * 64 + l_g * 8 + l_o ))\"
  }

  a_files=(/etc/profile /etc/bashrc /etc/bash.bashrc /etc/profile.d/sh.local)
  while IFS= read -r -d $'\\0' l_file; do
  a_files+=(\"$l_file\")
  done < <(/bin/find /etc/profile.d/ -type f -name '*.sh' -print0 2>/dev/null)

  for l_file in \"${a_files[@]}\"; do
  [ -r \"$l_file\" ] || continue
  /bin/grep -Psi -- '^[[:blank:]]*umask[[:blank:]]+\\S' \"$l_file\" 2>/dev/null | while IFS= read -r l_line; do
  l_arg=\"$(printf '%s' \"$l_line\" | /bin/grep -Poi -- '^[[:blank:]]*umask[[:blank:]]+\\K[^[:space:]#]+')\"
  [ -n \"$l_arg\" ] || continue
  l_dec=\"$(f_umask_to_dec \"$l_arg\")\"
  { [ \"$l_dec\" = 'INVALID' ] || [ \"$(( l_dec & l_floor ))\" -ne \"$l_floor\" ]; } && printf '%s: %s
' \"$l_file\" \"$l_line\"
  done
  done } | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
      expect      : "^pass$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "6.1.1.1 Ensure journald service is active"
      info        : "systemd-journald is the systemd journaling service that collects and stores system log data. It is a static, socket-activated unit that is always present as the initial collector of log events on a systemd-based system; it is started by systemd rather than enabled to start on boot.

systemd-journald must be running for the system to capture log events. If the service is not active, log events are not collected, removing the local record needed to detect, investigate, and respond to security-relevant activity."
      solution    : "Run the following commands to unmask and start systemd-journald.service:

# systemctl unmask systemd-journald.service
# systemctl start systemd-journald.service"
