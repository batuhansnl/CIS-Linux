      regex       : "^(?i)[\\s]*FirewallBackend\\h*=\\h*iptables\\b"
      expect      : "^(?i)[\\s]*FirewallBackend\\h*=\\h*iptables\\b"
    </custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "Condition check"
          cmd         : "/bin/systemctl is-active firewalld | /bin/awk '{print} END {if(NR==0) print \"inactive\" }'"
          expect      : "^active$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "Condition check"
          cmd         : "/bin/systemctl is-enabled firewalld | /bin/awk '{print} END {if(NR==0) print \"disabled\" }'"
          expect      : "^enabled$"
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "4.1.3 Ensure firewalld.service is configured"
          info        : "firewalld.service is a firewall service daemon that provides a dynamic, customizable firewall with a D-Bus interface.

firewalld.service must be active to enforce rules configured through FirewallD. firewalld.service must be enabled to start automatically after a system reboot."
          solution    : "Run the following commands to unmask, enable, and start firewalld.service :

# systemctl unmask firewalld.service
# systemctl --now enable firewalld.service

Impact:

Enabling and starting firewalld.service activates host-based packet filtering: from that point, incoming traffic is evaluated against the applicable zone and any traffic that is not permitted is blocked. Ensure the services and ports required for the system's role - including remote administration such as SSH - are allowed, or connectivity to the system can be affected."
