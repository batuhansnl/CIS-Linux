      cmd         : "#!/bin/bash

{
   a_path=(-path \"*/containers/storage/*\" -o -path \"*/containerd/*\" -o -path \"*/kubelet/*\" -o -path \"*/docker/*\" -o -path \"/sys/*\" -o -path \"/snap/*\" -o -path \"/boot/efi/*\")
   while IFS= read -r l_mount; do
      find \"$l_mount\" -mount -xdev \\( \"${a_path[@]}\" \\) -prune -o \\
         \\( \\( -type f -perm -0002 \\) -o \\( -type d -perm -0002 ! -perm -1000 \\) \\) \\
         -printf '%y %p\\n' 2>/dev/null
   done < <(findmnt -Dkerno fstype,target | awk '($1 !~ /^[[:space:]]*(nfs|proc|cifs|smb|vfat|iso9660|efivarfs|selinuxfs|ncpfs)/ && $2 !~ /^(\\/run|\\/tmp|\\/var\\/tmp)(\\/|$)/){print $2}')
} | /bin/awk '{print} END {if (NR == 0) print \"pass\"; else print \"fail\"}'"
