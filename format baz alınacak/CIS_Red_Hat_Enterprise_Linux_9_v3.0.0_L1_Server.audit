      cmd         : "sugroup=$(/bin/grep -Pi '^\\h*auth\\h+(?:required|requisite)\\h+pam_wheel\\.so\\h+(?:[^#\\n\\r]+\\h+)?((?!\\2)(use_uid\\b|group=\\H+\\b))\\h+(?:[^#\\n\\r]+\\h+)?((?!\\1)(use_uid\\b|group=\\H+\\b))(\\h+.*)?$' /etc/pam.d/su | /bin/awk 'BEGIN { FS = \"=\" } ; { print $2 }'); if [ -z \"$sugroup\" ]; then echo \"fail - sugroup not found in /etc/pam.d/su\"; else fail=0; for grp in $(printf '%s\\n' \"$sugroup\" | /bin/tr ':' '\\n'); do members=$(/bin/awk -F: -v g=\"$grp\" '$1==g {print $4}' /etc/group); if [ -n \"$members\" ]; then fail=1; echo \"$grp: fail - group not empty ($members)\"; else echo \"$grp: pass - group empty\"; fi; done; if [ \"$fail\" -eq 0 ]; then echo \"pass - all groups empty\"; else echo \"fail - one or more groups not empty\"; fi; fi"
      expect      : "pass - all groups empty"
    </custom_item>

