      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "Running configuration"
          cmd         : "/sbin/grubby --info=ALL | /bin/grep -Po '(selinux|enforcing)=0\\b' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
