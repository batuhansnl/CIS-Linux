# ==============================================================================
# BÖLÜM 1: DOSYA SİSTEMLERİ VE DEPOLAMA SIKILAŞTIRMASI
# ==============================================================================
# AYARIN AMACI: Linux çekirdeğindeki kullanılmayan eski dosya sistemi sürücülerinin
# ve USB depolama aygıtlarının kapatılmasıdır.
# GÜVENLİK RİSKİ: Bir saldırgan bozuk imaj dosyaları bağlayarak çekirdekteki bellek
# taşması açıklarını tetikleyebilir ve doğrudan root yetkisi kazanabilir.
# BULGU SEVİYESİ: ORTA / DÜŞÜK
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 1.1.1 cramfs Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.1 cramfs dosya sistemi surucusunun devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: cramfs salt okunur eski bir gomulu dosya sistemidir.
TEHLIKE: Saldirgan bozuk cramfs imajlariyla kernel zafiyeti tetikleyebilir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install cramfs /bin/true' > /etc/modprobe.d/cramfs.conf && rmmod cramfs 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|1.1.1.1"
  cmd         : "/sbin/modprobe -n -v cramfs 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module cramfs not found|cannot find module cramfs)"
  severity    : MEDIUM
</custom_item>

# 1.1.2 freevxfs Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.2 freevxfs dosya sistemi surucusunun devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Veritas dosya sistemi surucusudur, sunucularda kullanilmaz.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install freevxfs /bin/true' > /etc/modprobe.d/freevxfs.conf && rmmod freevxfs 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|1.1.1.2"
  cmd         : "/sbin/modprobe -n -v freevxfs 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module freevxfs not found|cannot find module freevxfs)"
  severity    : LOW
</custom_item>

# 1.1.3 jffs2 Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.3 jffs2 dosya sistemi surucusunun devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Flaş bellek dosya sistemidir. Kurumsal sunucularda atak yuzeyini azaltmak icin kapatilir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install jffs2 /bin/true' > /etc/modprobe.d/jffs2.conf && rmmod jffs2 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|1.1.1.3"
  cmd         : "/sbin/modprobe -n -v jffs2 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module jffs2 not found|cannot find module jffs2)"
  severity    : LOW
</custom_item>

# 1.1.4 hfs ve hfsplus Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.4 hfs ve hfsplus dosya sistemi suruculerinin devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Eski Apple dosya sistemleridir. Linux sunucularda gereksizdir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install hfs /bin/true' > /etc/modprobe.d/hfs.conf && echo 'install hfsplus /bin/true' > /etc/modprobe.d/hfsplus.conf"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|1.1.1.4"
  cmd         : "/sbin/modprobe -n -v hfs 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module hfs not found|cannot find module hfs)"
  severity    : LOW
</custom_item>

# 1.1.5 udf Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.5 udf dosya sistemi surucusunun devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Optik CD/DVD dosya bicimidir. Sunucuda fiziksel optik surucu yoksa kapatilmalidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install udf /bin/true' > /etc/modprobe.d/udf.conf && rmmod udf 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|1.1.1.5"
  cmd         : "/sbin/modprobe -n -v udf 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module udf not found|cannot find module udf)"
  severity    : LOW
</custom_item>

# 1.1.6 USB Depolama (usb-storage) Devre Dışı Bırakılması
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "1.1.6 usb-storage surucusunun devre disi birakildigini dogrula"
  info        : "AYARIN ANLAMI: Sunucuya fiziksel USB bellek takilarak veri sizdirilmasini veya zararli yazilim yuklenmesini engeller.
TEHLIKE: Fiziksel erisimi olan kisilerin sisteme dogrudan USB bellek ile sizmasini engeller.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install usb-storage /bin/true' > /etc/modprobe.d/usb-storage.conf && rmmod usb-storage 2>/dev/null"
  reference   : "800-53|MP-7,CSCv8|3.3,CIS-L1|1.1.23"
  cmd         : "/sbin/modprobe -n -v usb-storage 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module usb-storage not found|cannot find module usb-storage)"
  severity    : MEDIUM
</custom_item>

# ==============================================================================
# BÖLÜM 2: DİSK BÖLÜMLERİ VE GÜVENLİ MOUNT SEÇENEKLERİ
# ==============================================================================
# AYARIN AMACI: /tmp, /var/tmp, /dev/shm gibi herkesin yazabildiği geçici dizinlerde
# 'nodev', 'nosuid' ve 'noexec' bayraklarını zorunlu kılmaktır.
# GÜVENLİK RİSKİ: Saldırganlar web açıkları (RCE/LFI) veya düşük yetkili kullanıcılar
# üzerinden zararlı script veya SUID rootkitlerini bu dizinlere yazıp çalıştırır.
# Bu bayraklar saldırganın zararlı kodunu çalıştırmasını anında engeller!
# BULGU SEVİYESİ: YÜKSEK (High Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 2.1 /dev/shm 'nodev'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.1 /dev/shm bolumunde 'nodev' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /dev/shm altinda ozel aygit dosyasi (device file) olusturulamaz.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/fstab dosyasinda /dev/shm satirina 'nodev' ekleyin: mount -o remount,nodev /dev/shm"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.15"
  cmd         : "mount | grep -E '\s/dev/shm\s'"
  expect      : "nodev"
  severity    : HIGH
</custom_item>

# 2.2 /dev/shm 'nosuid'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.2 /dev/shm bolumunde 'nosuid' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /dev/shm altinda SUID izinli dosya calistirilarak root olunamaz!
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/fstab icinde /dev/shm satirina 'nosuid' ekleyin: mount -o remount,nosuid /dev/shm"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.16"
  cmd         : "mount | grep -E '\s/dev/shm\s'"
  expect      : "nosuid"
  severity    : HIGH
</custom_item>

# 2.3 /dev/shm 'noexec'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.3 /dev/shm bolumunde 'noexec' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /dev/shm altinda hicbir ikili kod (binary/script) dogrudan calistirilamaz.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/fstab icinde /dev/shm satirina 'noexec' ekleyin: mount -o remount,noexec /dev/shm"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.17"
  cmd         : "mount | grep -E '\s/dev/shm\s'"
  expect      : "noexec"
  severity    : HIGH
</custom_item>

# 2.4 /tmp 'nodev'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.4 /tmp bolumunde 'nodev' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /tmp altinda aygit dosyalari engellenir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "mount -o remount,nodev /tmp"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.3"
  cmd         : "mount | grep -E '\s/tmp\s'"
  expect      : "nodev"
  severity    : MEDIUM
</custom_item>

# 2.5 /tmp 'nosuid'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.5 /tmp bolumunde 'nosuid' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /tmp altindaki dosyalar calistirildiginda root yetkisi kazanamaz.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "mount -o remount,nosuid /tmp"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.4"
  cmd         : "mount | grep -E '\s/tmp\s'"
  expect      : "nosuid"
  severity    : HIGH
</custom_item>

# 2.6 /tmp 'noexec'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.6 /tmp bolumunde 'noexec' bayraginin ayarli oldugunu dogrula"
  info        : "AYARIN ANLAMI: /tmp altinda program veya script calistirilamaz.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "mount -o remount,noexec /tmp"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.5"
  cmd         : "mount | grep -E '\s/tmp\s'"
  expect      : "noexec"
  severity    : HIGH
</custom_item>

# 2.7 /var/tmp 'nodev', 'nosuid', 'noexec'
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "2.7 /var/tmp bolumunde 'nosuid' ve 'noexec' bayraklarini dogrula"
  info        : "AYARIN ANLAMI: /var/tmp gecici dizininde yetki yukseltme ve kod calistirma engellenir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "mount -o remount,nodev,nosuid,noexec /var/tmp"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.1.8"
  cmd         : "mount | grep -E '\s/var/tmp\s'"
  expect      : "nosuid"
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 3: SÜREÇ SIKILAŞTIRMASI, ASLR, PTRACE VE BOOTLOADER GÜVENLİĞİ
# ==============================================================================
# AYARIN AMACI: Bellek dökümlerinin engellenmesi, ASLR ile bellek düzeninin
# rastgeleleştirilmesi, ptrace yetkilerinin sınırlandırılması ve GRUB yapılandırma
# dosyasının korunmasıdır.
# GÜVENLİK RİSKİ: Bellek dökümleri parolaları ifşa eder. Zayıf GRUB izinleri ise
# sunucuya yerel/konsol erişimi olan birinin tek kullanıcı moduna (single-user / init 1)
# geçerek şifresiz root olmasını sağlar!
# BULGU SEVİYESİ: YÜKSEK / ORTA
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 3.1 limits.conf Core Dump 0
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "3.1 /etc/security/limits.conf icinde core dump sinirinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Hicbir kullanicinin core dump (bellek dokumu) uretememesidir.
TEHLIKE: Coken programlarin bellekteki sifreleri diske yazmasini onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '* hard core 0' >> /etc/security/limits.conf"
  reference   : "800-53|SC-7,CSCv8|8.5,CIS-L1|1.5.1"
  file        : "/etc/security/limits.conf"
  regex       : "^\*\s+hard\s+core\s+"
  expect      : "^\*\s+hard\s+core\s+0"
  severity    : MEDIUM
</custom_item>

# 3.2 sysctl fs.suid_dumpable = 0
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "3.2 sysctl fs.suid_dumpable degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: SUID (root yetkili) surecler cokerse bellek dokumu uretilmez.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w fs.suid_dumpable=0 && echo 'fs.suid_dumpable = 0' > /etc/sysctl.d/60-fs.conf"
  reference   : "800-53|SC-7,CSCv8|8.5,CIS-L1|1.5.2"
  cmd         : "/sbin/sysctl fs.suid_dumpable"
  expect      : "^fs\.suid_dumpable\s*=\s*0"
  severity    : MEDIUM
</custom_item>

# 3.3 ASLR: kernel.randomize_va_space = 2
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "3.3 sysctl kernel.randomize_va_space degerinin '2' (Tam ASLR) oldugunu dogrula"
  info        : "AYARIN ANLAMI: Programlarin bellekteki adreslerini rastgele dizer.
TEHLIKE: Buffer overflow (bellek tasmasi) exploitlerinin basari sansini sifirlar!
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w kernel.randomize_va_space=2 && echo 'kernel.randomize_va_space = 2' > /etc/sysctl.d/60-aslr.conf"
  reference   : "800-53|SI-16,CSCv8|8.5,CIS-L1|1.5.3"
  cmd         : "/sbin/sysctl kernel.randomize_va_space"
  expect      : "^kernel\.randomize_va_space\s*=\s*2"
  severity    : HIGH
</custom_item>

# 3.4 Ptrace Kısıtlaması (kernel.yama.ptrace_scope >= 1)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "3.4 sysctl kernel.yama.ptrace_scope degerinin en az '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Bir surecin baska bir surecin bellegini okumasini (debugging/hooking) kisitlar.
TEHLIKE: Yetkisiz kullanicilarin bellekteki diger programlarin verilerini calma riskini onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w kernel.yama.ptrace_scope=1 && echo 'kernel.yama.ptrace_scope = 1' >> /etc/sysctl.d/60-ptrace.conf"
  reference   : "800-53|AC-6,CSCv8|8.5,CIS-L1|1.5.4"
  cmd         : "/sbin/sysctl kernel.yama.ptrace_scope 2>/dev/null"
  expect      : "^kernel\.yama\.ptrace_scope\s*=\s*[1-3]"
  severity    : MEDIUM
</custom_item>

# 3.5 GRUB Yapılandırma Dosyası İzinleri (0600 root:root)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "3.5 GRUB bootloader yapilandirma dosyasinin izinlerinin 600 oldugunu dogrula"
  info        : "AYARIN ANLAMI: /boot/grub2/grub.cfg veya /boot/grub/grub.cfg dosyasini sadece root okuyup yazabilir.
TEHLIKE: Dosyayi degistiren bir kisi acilis parametrelerine 'init=/bin/sh' ekleyip sifresiz root olabilir!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "find /boot -name 'grub*.cfg' -exec chmod 600 {} + -exec chown root:root {} +"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.4.1"
  cmd         : "stat -c '%a %u %g' $(find /boot -name 'grub*.cfg' 2>/dev/null | head -n 1)"
  expect      : "^(600|400) 0 0$"
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 4: ÇEKİRDEK VE TCP/IP AĞ PARAMETRELERİ (SYSCTL)
# ==============================================================================
# AYARIN AMACI: Linux çekirdeğinin ağ yığınını kurumsal sunucu güvenliğine göre
# ayarlamaktır.
# GÜVENLİK RİSKİ: Varsayılan Linux TCP/IP ayarları yönlendirici (router) gibi
# çalışmaya ve sahte paketlere toleranslıdır. Bu ayarlar kapatılmazsa IP Spoofing,
# Man-in-the-Middle (MitM) ve SYN Flood DoS saldırıları başarılı olur.
# BULGU SEVİYESİ: YÜKSEK / ORTA
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 4.1 IP Forwarding Kapalı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.1 sysctl net.ipv4.ip_forward degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucunun aglar arasi paket yonlendirmesini (routing) kapatir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.ip_forward=0 && echo 'net.ipv4.ip_forward = 0' > /etc/sysctl.d/60-net.conf"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.1.1"
  cmd         : "/sbin/sysctl net.ipv4.ip_forward"
  expect      : "^net\.ipv4\.ip_forward\s*=\s*0"
  severity    : HIGH
</custom_item>

# 4.2 Send Redirects Kapalı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.2 sysctl send_redirects degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucunun agdaki diger cihazlara rota degistirme paketi gonderememesidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.send_redirects=0 && sysctl -w net.ipv4.conf.default.send_redirects=0"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.1.2"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.send_redirects"
  expect      : "^net\.ipv4\.conf\.all\.send_redirects\s*=\s*0"
  severity    : MEDIUM
</custom_item>

# 4.3 Accept Source Route Kapalı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.3 sysctl accept_source_route degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Paketi gonderenin belirttigi rotanin kabul edilmemesidir.
TEHLIKE: Saldirganin guvenlik duvarlarini atlatarak sahte IP ile baglanmasini onler.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.accept_source_route=0 && sysctl -w net.ipv4.conf.default.accept_source_route=0"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.2.1"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.accept_source_route"
  expect      : "^net\.ipv4\.conf\.all\.accept_source_route\s*=\s*0"
  severity    : HIGH
</custom_item>

# 4.4 Accept ICMP Redirects Kapalı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.4 sysctl accept_redirects degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Disaridan gelen sahte rota yonlendirme paketlerinin reddedilmesidir.
TEHLIKE: Ag trafiginin saldirgan makineye kaydirilmasini (Man-in-the-Middle) onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.accept_redirects=0 && sysctl -w net.ipv4.conf.default.accept_redirects=0"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.2.2"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.accept_redirects"
  expect      : "^net\.ipv4\.conf\.all\.accept_redirects\s*=\s*0"
  severity    : MEDIUM
</custom_item>

# 4.5 Secure ICMP Redirects Kapalı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.5 sysctl secure_redirects degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Yalnizca bilinen gateway'lerden gelse dahi redirect paketlerinin reddedilmesidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.secure_redirects=0 && sysctl -w net.ipv4.conf.default.secure_redirects=0"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.2.3"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.secure_redirects"
  expect      : "^net\.ipv4\.conf\.all\.secure_redirects\s*=\s*0"
  severity    : MEDIUM
</custom_item>

# 4.6 Log Martians Aktif
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.6 sysctl log_martians degerinin '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Gelmesi mantiksiz sahte paketlerin loglanmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.log_martians=1 && sysctl -w net.ipv4.conf.default.log_martians=1"
  reference   : "800-53|AU-2,CSCv8|8.2,CIS-L1|3.2.4"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.log_martians"
  expect      : "^net\.ipv4\.conf\.all\.log_martians\s*=\s*1"
  severity    : MEDIUM
</custom_item>

# 4.7 Ignore ICMP Broadcasts Aktif
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.7 sysctl icmp_echo_ignore_broadcasts degerinin '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Broadcast IP'ye gonderilen ping isteklerine yanit verilmemesidir.
TEHLIKE: Sunucunun Smurf DoS saldirisinda yuksek trafik ureten bir araci yapilmasini onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.icmp_echo_ignore_broadcasts=1"
  reference   : "800-53|SC-5,CSCv8|4.4,CIS-L1|3.2.5"
  cmd         : "/sbin/sysctl net.ipv4.icmp_echo_ignore_broadcasts"
  expect      : "^net\.ipv4\.icmp_echo_ignore_broadcasts\s*=\s*1"
  severity    : MEDIUM
</custom_item>

# 4.8 Ignore Bogus ICMP Responses Aktif
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.8 sysctl icmp_ignore_bogus_error_responses degerinin '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Hatali ICMP hata paketlerinin loglari doldurmasini engeller.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.icmp_ignore_bogus_error_responses=1"
  reference   : "800-53|SC-5,CSCv8|4.4,CIS-L1|3.2.6"
  cmd         : "/sbin/sysctl net.ipv4.icmp_ignore_bogus_error_responses"
  expect      : "^net\.ipv4\.icmp_ignore_bogus_error_responses\s*=\s*1"
  severity    : LOW
</custom_item>

# 4.9 Reverse Path Filtering (rp_filter = 1)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.9 sysctl rp_filter (Reverse Path) degerinin '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: IP Spoofing (sahte kaynak IP) saldirilarini filtreler.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.conf.all.rp_filter=1 && sysctl -w net.ipv4.conf.default.rp_filter=1"
  reference   : "800-53|SC-7,CSCv8|4.4,CIS-L1|3.2.7"
  cmd         : "/sbin/sysctl net.ipv4.conf.all.rp_filter"
  expect      : "^net\.ipv4\.conf\.all\.rp_filter\s*=\s*1"
  severity    : HIGH
</custom_item>

# 4.10 TCP SYN Cookies (tcp_syncookies = 1)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.10 sysctl net.ipv4.tcp_syncookies degerinin '1' oldugunu dogrula"
  info        : "AYARIN ANLAMI: TCP SYN Flood DoS saldirisinda sunucunun baglanti tablosunun kilitlenmesini engeller.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv4.tcp_syncookies=1"
  reference   : "800-53|SC-5,CSCv8|4.4,CIS-L1|3.2.8"
  cmd         : "/sbin/sysctl net.ipv4.tcp_syncookies"
  expect      : "^net\.ipv4\.tcp_syncookies\s*=\s*1"
  severity    : HIGH
</custom_item>

# 4.11 IPv6 Router Advertisement (accept_ra = 0)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.11 sysctl net.ipv6.conf.all.accept_ra degerinin '0' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucunun sahte IPv6 yonlendirici duyurularini kabul etmesini yasaklar.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sysctl -w net.ipv6.conf.all.accept_ra=0 2>/dev/null && sysctl -w net.ipv6.conf.default.accept_ra=0 2>/dev/null"
  reference   : "800-53|AC-4,CSCv8|4.4,CIS-L1|3.3.1"
  cmd         : "/sbin/sysctl net.ipv6.conf.all.accept_ra 2>/dev/null || echo 'net.ipv6.conf.all.accept_ra = 0'"
  expect      : "^net\.ipv6\.conf\.all\.accept_ra\s*=\s*0"
  severity    : MEDIUM
</custom_item>

# 4.12 Egzotik Protokoller (DCCP, SCTP, RDS, TIPC) Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "4.12 DCCP, SCTP, RDS ve TIPC egzotik ag protokollerinin devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucularda kullanilmayan nadir protokol suruculerinin kapatilmasidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'install dccp /bin/true' > /etc/modprobe.d/dccp.conf
echo 'install sctp /bin/true' > /etc/modprobe.d/sctp.conf
echo 'install rds /bin/true' > /etc/modprobe.d/rds.conf
echo 'install tipc /bin/true' > /etc/modprobe.d/tipc.conf"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|3.4.1"
  cmd         : "/sbin/modprobe -n -v dccp 2>&1"
  expect      : "(install /bin/(true|false)|FATAL: Module dccp not found|cannot find module dccp)"
  severity    : LOW
</custom_item>

# ==============================================================================
# BÖLÜM 5: SUNUCUDA ASLA BULUNMAMASI GEREKEN GÜVENSİZ SERVİSLER
# ==============================================================================
# AYARIN AMACI: Linux sunucularda gereksiz açık kapı (dinleyen port) bırakan,
# şifresiz iletişim kuran veya sunucu rolüne aykırı servislerin kaldırılmasıdır.
# GÜVENLİK RİSKİ:
# - CUPS: Yazdırma servisi sunucuda çalışmamalıdır; son yıllarda birçok uzaktan kod
#   çalıştırma (RCE) zafiyeti CUPS üzerinden çıkmıştır.
# - Avahi (mDNS): Ağda otomatik yayın yaparak sunucunun varlığını ve IP'sini ifşa eder.
# - Telnet / RSH / NIS: Şifreleri açık metin iletir, MITM ile kolayca çalınır.
# BULGU SEVİYESİ: KRİTİK / YÜKSEK
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 5.1 CUPS Yazdırma Servisi Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.1 CUPS (Yazdirma) servisinin devre disi ve kapali oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucularda yazici servisi bulunmamalidir.
TEHLIKE: CUPS uzerindeki uzaktan kod calistirma (RCE) aciklarini tamamen bertaraf eder.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl stop cups 2>/dev/null && systemctl disable cups 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.2.4"
  cmd         : "systemctl is-active cups 2>&1 || echo 'inactive'"
  expect      : "(inactive|failed|could not be found)"
  severity    : HIGH
</custom_item>

# 5.2 Avahi Daemon (mDNS/Zeroconf) Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.2 Avahi daemon (mDNS) servisinin devre disi oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucunun yerel aga otomatik hostname ve servis yayini yapmasini engeller.
TEHLIKE: Saldirgana sunucunun kimligini ve rollerini ifsa etmeyi onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl stop avahi-daemon 2>/dev/null && systemctl disable avahi-daemon 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.2.3"
  cmd         : "systemctl is-active avahi-daemon 2>&1 || echo 'inactive'"
  expect      : "(inactive|failed|could not be found)"
  severity    : MEDIUM
</custom_item>

# 5.3 xinetd / inetd Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.3 xinetd veya inetd super-server servisinin bulunmadigini dogrula"
  info        : "AYARIN ANLAMI: Eski servislerin arka planda gizlice calistirilmasini engeller.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl stop xinetd 2>/dev/null && systemctl disable xinetd 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.1.1"
  cmd         : "systemctl is-active xinetd 2>&1 || echo 'inactive'"
  expect      : "(inactive|failed|could not be found)"
  severity    : HIGH
</custom_item>

# 5.4 Telnet Sunucusu ve İstemcisi Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.4 Telnet sunucu ve istemcisinin kurulu olmadigini dogrula"
  info        : "AYARIN ANLAMI: Sifresiz metin aktaran telnet protokolunun tamamen kaldirilmasidir.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "RHEL/CentOS: dnf remove telnet telnet-server
Ubuntu/Debian: apt purge telnet telnetd"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.3.1"
  cmd         : "which telnet 2>&1 || echo 'not found'"
  expect      : "(no telnet in|not found)"
  severity    : HIGH
</custom_item>

# 5.5 RSH Sunucusu ve İstemcisi Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.5 RSH/Rlogin/Rcp paketlerinin kurulu olmadigini dogrula"
  info        : "AYARIN ANLAMI: Eski guvensiz uzak komut calistirma istemcilerinin kaldirilmasidir.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "RHEL: dnf remove rsh rsh-server
Ubuntu: apt purge rsh-client rsh-redone-client"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.3.2"
  cmd         : "which rsh 2>&1 || echo 'not found'"
  expect      : "(no rsh in|not found)"
  severity    : HIGH
</custom_item>

# 5.6 NIS (Network Information Service - ypbind) Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.6 NIS (ypbind) servisinin kurulu ve aktif olmadigini dogrula"
  info        : "AYARIN ANLAMI: Eski sifresiz ag kimlik dogrulama servisinin kullanililmamasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl stop ypbind 2>/dev/null && systemctl disable ypbind 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.3.3"
  cmd         : "systemctl is-active ypbind 2>&1 || echo 'inactive'"
  expect      : "(inactive|failed|could not be found)"
  severity    : HIGH
</custom_item>

# 5.7 TFTP Sunucusu Devre Dışı
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "5.7 TFTP sunucusunun kurulu veya aktif olmadigini dogrula"
  info        : "AYARIN ANLAMI: Sifreleme ve kimlik dogrulama destegi olmayan dosya transfer servisinin kapatilmasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl stop tftp 2>/dev/null && systemctl disable tftp 2>/dev/null"
  reference   : "800-53|CM-7,CSCv8|4.8,CIS-L1|2.2.6"
  cmd         : "systemctl is-active tftp 2>&1 || echo 'inactive'"
  expect      : "(inactive|failed|could not be found)"
  severity    : HIGH
</custom_item>

# 5.8 SNMP Varsayılan Topluluk Dizgileri ('public', 'private') Yok
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK_NOT
  description : "5.8 SNMP: Varsayilan 'public' veya 'private' topluluk dizgilerinin kullanilmadigini dogrula"
  info        : "AYARIN ANLAMI: SNMP servisinin fabrika cikisi tahmin edilebilir sifrelerle calismasini yasaklar.
TEHLIKE: Saldirgan 'public' stringi ile sunucunun tum donanim ve ag yapisini haritalayabilir!
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/snmp/snmpd.conf icerisindeki 'public' ve 'private' satirlarini silin ve guclu SNMPv3 yapilandirin."
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|2.2.14"
  file        : "/etc/snmp/snmpd.conf"
  regex       : "^\s*(rocommunity|rwcommunity)\s+"
  expect      : "^\s*(rocommunity|rwcommunity)\s+(public|private)\b"
  file_required : NO
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 6: SSH SUNUCU GÜVENLİK SIKILAŞTIRMASI (/etc/ssh/sshd_config)
# ==============================================================================
# AYARIN AMACI: Uzaktan yönetim için kullanılan SSH servisinin en katı güvenlik
# parametreleriyle çalışmasını sağlamaktır.
# GÜVENLİK RİSKİ: Linux sunuculara yapılan siber saldırıların %90'ından fazlası
# SSH portuna brute-force veya zayıf anahtar/şifreleme denemeleriyle başlar.
# BULGU SEVİYESİ: KRİTİK / YÜKSEK (Critical / High Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 6.1 PermitRootLogin no
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.1 SSH: PermitRootLogin ayarinin 'no' oldugunu dogrula"
  info        : "AYARIN ANLAMI: SSH ile dogrudan 'root' adiyla uzaktan oturum acilamaz.
TEHLIKE: Saldirgan dogrudan root hesabina saldiramaz. Yonetici kisisel hesabini kullanip sonra sudo yapmalidir.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && systemctl restart sshd || systemctl restart ssh"
  reference   : "800-53|AC-6,CSCv8|4.1,CIS-L1|5.2.5"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*PermitRootLogin\s+"
  expect      : "^\s*PermitRootLogin\s+no\b"
  severity    : HIGH
</custom_item>

# 6.2 PermitEmptyPasswords no
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.2 SSH: PermitEmptyPasswords ayarinin 'no' oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sifresi bos olan hesaplarin SSH ile girisini kesinlikle yasaklar.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'PermitEmptyPasswords no' >> /etc/ssh/sshd_config && systemctl reload sshd || systemctl reload ssh"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|5.2.9"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*PermitEmptyPasswords\s+"
  expect      : "^\s*PermitEmptyPasswords\s+no\b"
  severity    : HIGH
</custom_item>

# 6.3 MaxAuthTries <= 4
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.3 SSH: MaxAuthTries degerinin 4 veya daha az oldugunu dogrula"
  info        : "AYARIN ANLAMI: Baglanti basina yanlis sifre deneme siniridir.
TEHLIKE: Brute-force ve parola deneme saldirilarini engeller.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'MaxAuthTries 4' >> /etc/ssh/sshd_config"
  reference   : "800-53|AC-7,CSCv8|5.2,CIS-L1|5.2.7"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*MaxAuthTries\s+"
  expect      : "^\s*MaxAuthTries\s+([1-4])\b"
  severity    : HIGH
</custom_item>

# 6.4 ClientAliveInterval <= 300
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.4 SSH: ClientAliveInterval degerinin 300 veya daha az oldugunu dogrula"
  info        : "AYARIN ANLAMI: Bosta birakilan SSH oturumlarinin 5 dakikada bir kontrol edilmesidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'ClientAliveInterval 300' >> /etc/ssh/sshd_config && echo 'ClientAliveCountMax 3' >> /etc/ssh/sshd_config"
  reference   : "800-53|AC-12,CSCv8|4.1,CIS-L1|5.2.12"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*ClientAliveInterval\s+"
  expect      : "^\s*ClientAliveInterval\s+([1-9]|[1-9][0-9]|[1-2][0-9][0-9]|300)\b"
  severity    : MEDIUM
</custom_item>

# 6.5 HostbasedAuthentication no
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.5 SSH: HostbasedAuthentication ayarinin 'no' oldugunu dogrula"
  info        : "AYARIN ANLAMI: IP tabanli eski guvensiz giris mekanizmasini kapatir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'HostbasedAuthentication no' >> /etc/ssh/sshd_config"
  reference   : "800-53|IA-2,CSCv8|5.2,CIS-L1|5.2.8"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*HostbasedAuthentication\s+"
  expect      : "^\s*HostbasedAuthentication\s+no\b"
  severity    : MEDIUM
</custom_item>

# 6.6 X11Forwarding no
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "6.6 SSH: X11Forwarding ayarinin 'no' oldugunu dogrula"
