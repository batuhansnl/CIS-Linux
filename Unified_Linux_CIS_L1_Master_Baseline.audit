# ==============================================================================
# BÖLÜM 10: LOGLAMA VE SİSTEM DENETİMİ (AUDITD & RSYSLOG)
# ==============================================================================
# AYARIN AMACI: Linux Denetim Çerçevesi (auditd) ile saat değişimleri, kullanıcı
# yönetimi, dosya izin değişiklikleri ve ayrıcalıklı komut çalıştırmalarının
# kaydedilmesi ve rsyslog/journald ile log güvenliğinin sağlanmasıdır.
# GÜVENLİK RİSKİ: Bir siber olayda saldırganın izini sürebilmek (adli bilişim / forensics)
# ve tespit edebilmek için bu denetim kuralları zorunludur.
# BULGU SEVİYESİ: YÜKSEK / ORTA
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 10.1 auditd Servisi Aktif
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.1 auditd denetim servisinin aktif ve calisir oldugunu dogrula"
  info        : "AYARIN ANLAMI: Kernel seviyesinde guvenlik olaylarini izleyen auditd servisinin acik olmasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl enable auditd && systemctl start auditd"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.1.1"
  cmd         : "systemctl is-enabled auditd 2>&1"
  expect      : "^enabled$"
  severity    : HIGH
</custom_item>

# 10.2 rsyslog / journald Aktif
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.2 rsyslog veya journald log servisinin calistigini dogrula"
  info        : "AYARIN ANLAMI: Sistem loglarinin diske ve merkezi SIEM'e aktarilmasini saglar.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl enable rsyslog && systemctl start rsyslog"
  reference   : "800-53|AU-12,CSCv8|8.2,CIS-L1|4.2.1.1"
  cmd         : "systemctl is-active rsyslog 2>&1 || systemctl is-active systemd-journald 2>&1"
  expect      : "^active$"
  severity    : HIGH
</custom_item>

# 10.3 Saat/Tarih Değişikliklerinin Denetlenmesi (time-change)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.3 auditd: Sistem saati ve tarih degisikliklerinin denetlendigini dogrula"
  info        : "AYARIN ANLAMI: Sistem saatini degistiren adjtimex, settimeofday sistem cagrilarinin loglanmasidir.
TEHLIKE: Saldirganin log tarihlerini karistirarak adli bilisimi engellemesini onler.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time-change' >> /etc/audit/rules.d/audit.rules"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.3"
  cmd         : "/sbin/auditctl -l | grep -E '(adjtimex|settimeofday)'"
  expect      : "time-change"
  severity    : MEDIUM
</custom_item>

# 10.4 Kullanıcı ve Grup Dosyası Değişikliklerinin Denetlenmesi (identity)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.4 auditd: /etc/passwd ve /etc/shadow degisikliklerinin denetlendigini dogrula"
  info        : "AYARIN ANLAMI: Kullanici ve grup dosyalarina yapilan her turlu yazma/degistirme isleminin loglanmasidir.
TEHLIKE: Yetkisiz kullanici ekleme veya parola degistirme girisimlerini aninda yakalar.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '-w /etc/passwd -p wa -k identity' >> /etc/audit/rules.d/audit.rules
echo '-w /etc/shadow -p wa -k identity' >> /etc/audit/rules.d/audit.rules"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.4"
  cmd         : "/sbin/auditctl -l | grep identity"
  expect      : "identity"
  severity    : HIGH
</custom_item>

# 10.5 Sudoers Dosyası Değişikliklerinin Denetlenmesi (scope)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.5 auditd: /etc/sudoers degisikliklerinin denetlendigini dogrula"
  info        : "AYARIN ANLAMI: Yetki yonetim dosyasina yapilan her mudahalenin denetlenmesidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '-w /etc/sudoers -p wa -k scope' >> /etc/audit/rules.d/audit.rules
echo '-w /etc/sudoers.d/ -p wa -k scope' >> /etc/audit/rules.d/audit.rules"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.12"
  cmd         : "/sbin/auditctl -l | grep scope"
  expect      : "scope"
  severity    : HIGH
</custom_item>

# 10.6 Kernel Modülü Yükleme/Kaldırma Denetimi (modules)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.6 auditd: Kernel modul yukleme ve kaldirma islemlerinin denetlendigini dogrula"
  info        : "AYARIN ANLAMI: init_module veya delete_module ile rootkit yukleme girisimlerini loglar.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '-a always,exit -F arch=b64 -S init_module -S delete_module -k modules' >> /etc/audit/rules.d/audit.rules"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.15"
  cmd         : "/sbin/auditctl -l | grep modules"
  expect      : "modules"
  severity    : HIGH
</custom_item>

# 10.7 auditd Kurallarının Değiştirilemez Yapılması (-e 2)
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "10.7 auditd kurallarinin '-e 2' ile degistirilemez yapildigini dogrula"
  info        : "AYARIN ANLAMI: Sistem acildiktan sonra root kullanicisi dahil kimse auditd kurallarini silemez. Degisiklik icin sunucunun yeniden baslatilmasi gerekir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo '-e 2' >> /etc/audit/rules.d/audit.rules"
  reference   : "800-53|AU-12,CSCv8|8.5,CIS-L1|4.1.17"
  file        : "/etc/audit/rules.d/audit.rules"
  regex       : "^\s*-e\s+"
  expect      : "^\s*-e\s+2\b"
  file_required : NO
  severity    : MEDIUM
</custom_item>

# 10.8 Log Dosyaları İzinleri (0640 veya daha sıkı)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "10.8 /var/log altindaki log dosyalarinin izinlerinin 640 veya daha siki oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sistem loglarini yalnizca root ve log/adm grubu gorebilir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod g-wx,o-rwx /var/log/* 2>/dev/null"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|4.2.3"
  cmd         : "find /var/log -type f -perm /037 2>/dev/null | head -n 10"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 11: ZAMAN SENKRONİZASYONU (CHRONY VEYA TIMESYNCD)
# ==============================================================================
# AYARIN AMACI: Tüm sunucuların saatlerinin kurumsal bir NTP/Chrony kaynağı ile
# milisaniye hassasiyetinde senkronize olmasıdır.
# GÜVENLİK RİSKİ: Saatleri kayan sunucularda SIEM korelasyonu çöker, Kerberos
# oturumları düşer, SSL/TLS sertifika kontrolleri patlar ve adli tahlil yapılamaz.
# BULGU SEVİYESİ: ORTA (Medium Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "11.1 Zaman senkronizasyon servisinin (chrony, timesyncd veya ntp) calistigini dogrula"
  info        : "AYARIN ANLAMI: Sistem saatinin guvenilir ag saatiyle guncel kalmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl enable chronyd && systemctl start chronyd || systemctl enable systemd-timesyncd"
  reference   : "800-53|AU-8,CSCv8|8.4,CIS-L1|2.1.1"
  cmd         : "systemctl is-active chronyd 2>&1 || systemctl is-active systemd-timesyncd 2>&1 || systemctl is-active ntpd 2>&1"
  expect      : "^active$"
  severity    : MEDIUM
</custom_item>

# ==============================================================================
# BÖLÜM 12: GİRİŞ UYARI BANNERLARI VE BİLGİ SIZINTISI ENGELLEME
# ==============================================================================
# AYARIN AMACI: /etc/issue, /etc/issue.net ve /etc/motd dosyalarından işletim sistemi
# çekirdek ve patch sürümü gibi saldırganın işine yarayacak bilgilerin silinmesi,
# yerine kurumsal yasal uyarı konulmasıdır.
# BULGU SEVİYESİ: DÜŞÜK (Low Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 12.1 /etc/motd İzni 644
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "12.1 /etc/motd dosya izninin 644 ve sahibinin root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Gunun mesaji dosyasinin guvenligidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
