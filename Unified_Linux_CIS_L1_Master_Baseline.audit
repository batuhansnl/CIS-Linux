</custom_item>

# 12.4 Banner İçinde OS Sürüm Bilgisi Yok
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK_NOT
  description : "12.4 /etc/issue dosyasinda OS surum kacis dizisi (\\v, \\r, \\m) olmadigini dogrula"
  info        : "AYARIN ANLAMI: Giris bannerinda isletim sistemi surumu ifsa edilmez.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/issue ve /etc/issue.net icerisindeki \\v, \\r, \\m, \\s ifadelerini silin."
  reference   : "800-53|AC-8,CSCv8|5.1,CIS-L1|1.7.4"
  file        : "/etc/issue"
  regex       : "(\\v|\\r|\\m|\\s)"
  expect      : "(\\v|\\r|\\m|\\s)"
  severity    : LOW
</custom_item>

# ==============================================================================
# BÖLÜM 13: DAĞITIMA ÖZEL DİNAMİK KOŞULLU BLOKLAR (<if><condition>)
# ==============================================================================
# AYARIN ANLAMI: Nessus hedef makinenin /etc/os-release dosyasındaki kimliğine bakar:
# - RHEL / CentOS / Rocky / Oracle Linux ise: SELinux ve firewalld kontrol edilir.
# - Debian / Ubuntu ise: AppArmor ve UFW kontrol edilir.
# - SUSE / SLES_SAP ise: SUSE guvenlik modulleri kontrol edilir.
# Hedef sisteme uymayan blok otomatik olarak SKIPPED gecilir, taramada asla hata vermez!
# ==============================================================================

# ------------------------------------------------------------------------------
# 13.1 RED HAT AİLESİ (RHEL 7/8/9, Rocky Linux 8/9, CentOS 6/7, Oracle Linux 7/8/9)
# ------------------------------------------------------------------------------
<if>
  <condition type:"AND">
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "Sistemin Red Hat ailesi (RHEL/CentOS/Rocky/Oracle) olup olmadigini tespit et"
      cmd         : "grep -Ei 'rhel|centos|rocky|ol|red hat|fedora' /etc/os-release 2>/dev/null"
      expect      : "ID="
    </custom_item>
  </condition>
  <then>
    # 13.1.1 SELinux Durumu Enforcing
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.1.1 Red Hat Ailesi: SELinux durumunun 'Enforcing' oldugunu dogrula"
      info        : "AYARIN ANLAMI: Zorunlu Erisim Kontrolu (SELinux) korumasinin devrede olmasidir.
TEHLIKE: SELinux kapaliysa sisteme sizan bir saldirgan web uygulamasindan root yetkisine cok rahat ulasabilir!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: RHEL 7/8/9, Rocky 8/9, CentOS 6/7, Oracle Linux 7/8/9"
      solution    : "/etc/selinux/config dosyasinda SELINUX=enforcing yapin ve 'setenforce 1' calistirin."
      reference   : "800-53|AC-3,CSCv8|3.3,CIS-L1|1.6.1.2"
      cmd         : "/usr/sbin/getenforce 2>&1"
      expect      : "^Enforcing$"
      severity    : HIGH
    </custom_item>

    # 13.1.2 SELinux Yapılandırma Dosyası
    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK
      description : "13.1.2 Red Hat Ailesi: /etc/selinux/config icinde SELINUX=enforcing oldugunu dogrula"
      info        : "AYARIN ANLAMI: Yeniden baslatmada SELinux'un kalici olarak enforcing kalmasini saglar.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: RHEL 7/8/9, Rocky 8/9, CentOS 7, Oracle Linux 7/8/9"
      solution    : "sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config"
      reference   : "800-53|AC-3,CSCv8|3.3,CIS-L1|1.6.1.3"
      file        : "/etc/selinux/config"
      regex       : "^\s*SELINUX="
      expect      : "^\s*SELINUX=enforcing\b"
      severity    : HIGH
    </custom_item>

    # 13.1.3 firewalld Aktif
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.1.3 Red Hat Ailesi: firewalld servisinin aktif ve calisir oldugunu dogrula"
      info        : "AYARIN ANLAMI: RHEL tabanli sistemlerde yerel guvenlik duvarinin acik olmasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: RHEL 7/8/9, Rocky 8/9, CentOS 7, Oracle Linux 7/8/9"
      solution    : "systemctl enable firewalld && systemctl start firewalld"
      reference   : "800-53|SC-7,CSCv8|4.4,CIS-L1|3.5.1"
      cmd         : "systemctl is-active firewalld 2>&1"
      expect      : "^active$"
      severity    : HIGH
    </custom_item>

    # 13.1.4 RPM GPG Anahtar Doğrulaması (gpgcheck=1)
    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK
      description : "13.1.4 Red Hat Ailesi: dnf/yum icinde gpgcheck=1 oldugunu dogrula"
      info        : "AYARIN ANLAMI: Yuklenen RPM paketlerinin dijital imzalarinin dogrulanmasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: RHEL 7/8/9, Rocky 8/9, CentOS 7, Oracle Linux 7/8/9"
      solution    : "sed -i 's/^gpgcheck=.*/gpgcheck=1/' /etc/dnf/dnf.conf 2>/dev/null || sed -i 's/^gpgcheck=.*/gpgcheck=1/' /etc/yum.conf 2>/dev/null"
      reference   : "800-53|SI-7,CSCv8|2.2,CIS-L1|1.2.3"
      file        : "/etc/dnf/dnf.conf"
      regex       : "^\s*gpgcheck="
      expect      : "^\s*gpgcheck=1\b"
      file_required : NO
      severity    : HIGH
    </custom_item>
  </then>
</if>

# ------------------------------------------------------------------------------
# 13.2 DEBIAN VE UBUNTU AİLESİ (Ubuntu 18.04, 20.04, 22.04, 24.04, Debian 12/13)
# ------------------------------------------------------------------------------
<if>
  <condition type:"AND">
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "Sistemin Debian veya Ubuntu ailesi olup olmadigini tespit et"
      cmd         : "grep -Ei 'ubuntu|debian' /etc/os-release 2>/dev/null"
      expect      : "ID="
    </custom_item>
  </condition>
  <then>
    # 13.2.1 AppArmor Servisi Aktif
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.2.1 Debian/Ubuntu Ailesi: AppArmor servisinin aktif ve calisir oldugunu dogrula"
      info        : "AYARIN ANLAMI: Debian/Ubuntu uzerinde uygulama profillerini kisitlayan guvenlik moduludur.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Ubuntu 18/20/22/24 LTS, Debian 12/13"
      solution    : "systemctl enable apparmor && systemctl start apparmor"
      reference   : "800-53|AC-3,CSCv8|3.3,CIS-L1|1.6.1.1"
      cmd         : "systemctl is-active apparmor 2>&1"
      expect      : "^active$"
      severity    : HIGH
    </custom_item>

    # 13.2.2 UFW veya nftables Güvenlik Duvarı Aktif
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.2.2 Debian/Ubuntu Ailesi: UFW veya nftables guvenlik duvarinin aktif oldugunu dogrula"
      info        : "AYARIN ANLAMI: Ubuntu/Debian uzerinde yerel guvenlik duvarinin aktif olmasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Ubuntu 18/20/22/24 LTS, Debian 12/13"
      solution    : "ufw --force enable || systemctl enable nftables"
      reference   : "800-53|SC-7,CSCv8|4.4,CIS-L1|3.5.1"
      cmd         : "ufw status 2>&1 | grep -i 'Status: active' || systemctl is-active nftables 2>&1"
      expect      : "(Status: active|^active$)"
      severity    : HIGH
    </custom_item>
  </then>
</if>

# ------------------------------------------------------------------------------
# 13.3 SUSE AİLESİ (SLES 12, SLES 15 / SLES for SAP, SLES 16)
# ------------------------------------------------------------------------------
<if>
  <condition type:"AND">
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "Sistemin SUSE / SLES ailesi olup olmadigini tespit et"
      cmd         : "grep -Ei 'sles|suse' /etc/os-release 2>/dev/null"
      expect      : "ID="
    </custom_item>
  </condition>
  <then>
    # 13.3.1 AppArmor veya SELinux Aktif
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.3.1 SUSE Ailesi: AppArmor veya SELinux servisinin aktif oldugunu dogrula"
      info        : "AYARIN ANLAMI: SUSE Linux Enterprise Server ve SAP sistemlerinde zorunlu erisim kontroludur.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: SLES 12 (Kernel 4.x), SLES 15 / SAP (Kernel 5.x), SLES 16 (Kernel 6.x)"
      solution    : "systemctl enable apparmor && systemctl start apparmor"
      reference   : "800-53|AC-3,CSCv8|3.3,CIS-L1|1.6.1"
      cmd         : "systemctl is-active apparmor 2>&1 || /usr/sbin/getenforce 2>&1"
      expect      : "(^active$|^Enforcing$)"
      severity    : HIGH
    </custom_item>

    # 13.3.2 SUSE Güvenlik Duvarı Aktif
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "13.3.2 SUSE Ailesi: firewalld veya SuSEfirewall2 servisinin aktif oldugunu dogrula"
      info        : "AYARIN ANLAMI: SUSE uzerinde yerel guvenlik duvarinin calismasidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: SUSE Linux Enterprise (12, 15, 16)"
      solution    : "systemctl enable firewalld && systemctl start firewalld"
      reference   : "800-53|SC-7,CSCv8|4.4,CIS-L1|3.5.1"
      cmd         : "systemctl is-active firewalld 2>&1 || systemctl is-active SuSEfirewall2 2>&1"
      expect      : "^active$"
      severity    : HIGH
    </custom_item>
  </then>
</if>

</check_type>
