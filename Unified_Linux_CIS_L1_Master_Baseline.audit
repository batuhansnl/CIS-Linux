</custom_item>

# 12.2 /etc/issue İzni 644
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "12.2 /etc/issue dosya izninin 644 ve sahibinin root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Konsol giris banner dosyasinin sadece root tarafindan yazilabilmesidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 644 /etc/issue && chown root:root /etc/issue"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.7.2"
  file        : "/etc/issue"
  owner       : "root"
  group       : "root"
  mode        : "644"
  severity    : LOW
</custom_item>

# 12.3 /etc/issue.net İzni 644
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "12.3 /etc/issue.net dosya izninin 644 ve sahibinin root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Uzak ag (SSH) giris banner dosyasinin guvenligidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 644 /etc/issue.net && chown root:root /etc/issue.net"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|1.7.3"
  file        : "/etc/issue.net"
  owner       : "root"
  group       : "root"
  mode        : "644"
