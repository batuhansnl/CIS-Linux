# 6.12 sshd_config Dosya İzni 600
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "6.12 SSH: /etc/ssh/sshd_config dosya izninin 600 ve sahibinin root oldugunu dogrula"
  info        : "AYARIN ANLAMI: SSH konfigurasini sadece root okuyup yazabilir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 600 /etc/ssh/sshd_config && chown root:root /etc/ssh/sshd_config"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|5.2.1"
  file        : "/etc/ssh/sshd_config"
  owner       : "root"
  mask        : "177"
  severity    : HIGH
</custom_item>

# 6.13 SSH Özel Anahtarları (Private Host Keys) İzinleri 600
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "6.13 SSH: Ozel anahtar (private key) dosyalarinin 600 veya 640 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sunucunun SSH private anahtarlarini baskasi okuyamaz.
TEHLIKE: Private key sizarsa sunucunun trafigi cozulur ve sahte sunucu taklidi yapilabilir!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 600 /etc/ssh/*_key"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|5.2.2"
  cmd         : "find /etc/ssh -name '*_key' -perm /077 2>/dev/null"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 7: PAROLA POLİTİKASI, PAM VE KULLANICI HESAPLARI
# ==============================================================================
# AYARIN AMACI: Parola yaşlandırma sürelerinin sınırlandırılması, boş parolaların
# engellenmesi, güçlü parola karma algoritmaları (SHA512/yescrypt) ve hatalı girişte
# hesap kilitlemenin (pam_faillock) uygulanmasıdır.
# BULGU SEVİYESİ: KRİTİK / YÜKSEK
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 7.1 PASS_MAX_DAYS <= 365
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.1 /etc/login.defs icinde PASS_MAX_DAYS degerinin 365 veya daha az oldugunu dogrula"
  info        : "AYARIN ANLAMI: Parolalarin en fazla 1 yil gecerli olmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS 365/' /etc/login.defs"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|5.4.1.1"
  file        : "/etc/login.defs"
  regex       : "^\s*PASS_MAX_DAYS\s+"
  expect      : "^\s*PASS_MAX_DAYS\s+([1-9]|[1-9][0-9]|[1-2][0-9][0-9]|3[0-5][0-9]|365)\b"
  severity    : MEDIUM
</custom_item>

# 7.2 PASS_MIN_DAYS >= 1
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.2 /etc/login.defs icinde PASS_MIN_DAYS degerinin en az 1 gun oldugunu dogrula"
  info        : "AYARIN ANLAMI: Ayni gun ust uste parola degistirilip eski sifreye donulmesini engeller.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS 1/' /etc/login.defs"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|5.4.1.2"
  file        : "/etc/login.defs"
  regex       : "^\s*PASS_MIN_DAYS\s+"
  expect      : "^\s*PASS_MIN_DAYS\s+([1-9]|[1-9][0-9]+)\b"
  severity    : LOW
</custom_item>

# 7.3 PASS_WARN_AGE >= 7
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.3 /etc/login.defs icinde PASS_WARN_AGE degerinin en az 7 gun oldugunu dogrula"
  info        : "AYARIN ANLAMI: Parola dolmadan 7 gun once hatirlatma yapilmasidir.
BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE 7/' /etc/login.defs"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|5.4.1.3"
  file        : "/etc/login.defs"
  regex       : "^\s*PASS_WARN_AGE\s+"
  expect      : "^\s*PASS_WARN_AGE\s+([7-9]|[1-9][0-9]+)\b"
  severity    : LOW
</custom_item>

# 7.4 /etc/shadow Boş Parolalı Hesap Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "7.4 /etc/shadow dosyasinda bos parolali hesap bulunmadigini dogrula"
  info        : "AYARIN ANLAMI: Parolasiz hesap bulunmamasidir.
TEHLIKE: Sifresiz oturum acilmasina neden olan en buyuk guvenlik acigidir!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "awk -F: '($2 == "") {print $1}' /etc/shadow | xargs -r -n 1 passwd -l"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|5.4.2"
  cmd         : "awk -F: '($2 == "") {print $1}' /etc/shadow"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# 7.5 Sadece root UID 0
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "7.5 /etc/passwd icinde yalnizca 'root' kullanicisinin UID 0 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Sistemde gizli ikinci bir superuser (UID 0) hesabi bulunamaz.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "UID 0 olan diger hesaplari silin veya UID degistirin: awk -F: '($3 == 0 && $1 != "root") {print $1}' /etc/passwd"
  reference   : "800-53|AC-6,CSCv8|5.4,CIS-L1|5.4.3"
  cmd         : "awk -F: '($3 == 0) {print $1}' /etc/passwd"
  expect      : "^root$"
  severity    : HIGH
</custom_item>

# 7.6 Varsayılan Umask 027
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.6 /etc/profile veya /etc/bashrc icinde varsayilan umask degerinin 027 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Yeni olusturulan dosyalarin diger kullanicilara kapali olmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'umask 027' >> /etc/profile && echo 'umask 027' >> /etc/bashrc"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|5.4.4"
  file        : "/etc/profile"
  regex       : "^\s*umask\s+"
  expect      : "^\s*umask\s+027\b"
  severity    : MEDIUM
</custom_item>

# 7.7 Shell Zaman Aşımı (TMOUT <= 900 Saniye / 15 Dakika)
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.7 TMOUT oturum zaman asiminin 900 saniye (15 dk) veya daha az oldugunu dogrula"
  info        : "AYARIN ANLAMI: Bosta birakilan konsol ve SSH terminallerinin otomatik kapatilmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'readonly TMOUT=900; export TMOUT' >> /etc/profile.d/timeout.sh"
  reference   : "800-53|AC-12,CSCv8|4.1,CIS-L1|5.4.5"
  file        : "/etc/profile"
  regex       : "^\s*(typeset\s+-r\s+)?TMOUT="
  expect      : "^\s*(typeset\s+-r\s+)?TMOUT=([1-9]|[1-9][0-9]|[1-8][0-9][0-9]|900)\b"
  severity    : MEDIUM
</custom_item>

# 7.8 İnaktif Hesapların Kilitlenmesi (useradd -D -f 30)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "7.8 Parolasi dolduktan sonra inaktif kalan hesaplarin 30 gun icinde kilitlendigini dogrula"
  info        : "AYARIN ANLAMI: Parolasi bittigi halde yenilenmeyen hesaplarin otomatik kilitlenmesidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "useradd -D -f 30"
  reference   : "800-53|AC-2,CSCv8|5.3,CIS-L1|5.4.1.4"
  cmd         : "useradd -D | grep INACTIVE"
  expect      : "^INACTIVE=([1-9]|[1-2][0-9]|30)$"
  severity    : MEDIUM
</custom_item>

# 7.9 Sistem Servis Hesaplarının Kabukları (nologin)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "7.9 Sistem servis hesaplarinin (UID < 1000) giris kabugunun nologin oldugunu dogrula"
  info        : "AYARIN ANLAMI: daemon, bin, sys, nobody gibi hesaplarin interaktif kabuk (bash/sh) acamamasidir.
TEHLIKE: Web zafiyetiyle bu hesaplar ele gecirilirse interaktif shell alinmasi zorlasir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "usermod -s /sbin/nologin <hesap_adi>"
  reference   : "800-53|AC-2,CSCv8|5.4,CIS-L1|5.4.2"
  cmd         : "awk -F: '($1 != "root" && $1 != "sync" && $1 != "shutdown" && $1 != "halt" && $3 < 1000 && $7 !~ /(nologin|false)/) {print $1}' /etc/passwd"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# 7.10 su Komutuna Erişimin Kısıtlanması (pam_wheel.so)
<custom_item>
  system      : "Linux"
  type        : FILE_CONTENT_CHECK
  description : "7.10 su komutuna erisimin yalnizca wheel/sudo grubuna kisitlandigini dogrula"
  info        : "AYARIN ANLAMI: Yoldan gecen normal bir kullanicinin root sifresini bilse dahi 'su -' komutuyla root olamamasi, sadece wheel grubundakilerin su yapabilmesidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "/etc/pam.d/su dosyasinda su satiri aktif edin: auth required pam_wheel.so use_uid"
  reference   : "800-53|AC-3,CSCv8|5.4,CIS-L1|5.6"
  file        : "/etc/pam.d/su"
  regex       : "^\s*auth\s+required\s+pam_wheel\.so\s+"
  expect      : "^\s*auth\s+required\s+pam_wheel\.so\s+.*use_uid"
  severity    : HIGH
</custom_item>

# 7.11 Sudo Komut Logunun Yapılandırılması (logfile=/var/log/sudo.log)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "7.11 sudo islemlerinin ozel bir log dosyasina kaydedildigini dogrula"
  info        : "AYARIN ANLAMI: Yoneticilerin calistirdigi tum sudo komutlarinin /var/log/sudo.log icine yazilmasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'Defaults logfile="/var/log/sudo.log"' > /etc/sudoers.d/audit_sudo"
  reference   : "800-53|AU-2,CSCv8|8.5,CIS-L1|5.3.3"
  cmd         : "grep -rEi 'logfile\s*=' /etc/sudoers /etc/sudoers.d/ 2>/dev/null"
  expect      : "logfile="
  severity    : MEDIUM
</custom_item>

# ==============================================================================
# BÖLÜM 8: KRİTİK SİSTEM DOSYA İZİNLERİ VE BÜTÜNLÜK
# ==============================================================================
# AYARIN AMACI: /etc/passwd, /etc/shadow, /etc/group ve yedeklerinin izinlerinin
# en katı şekilde kilitlenmesi, sistemde sahipsiz veya world-writable dosya bulunmamasıdır.
# GÜVENLİK RİSKİ: Bu dosyalardaki tek bir izin hatası tüm sunucunun saniyeler içinde
# yetkisiz kişilerin kontrolüne geçmesine yol açar!
# BULGU SEVİYESİ: KRİTİK (Critical Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 8.1 /etc/passwd İzni 644
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.1 /etc/passwd dosya izninin 644 ve sahibinin root:root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Kullanici listesini herkes okur, yalnizca root degistirebilir.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 644 /etc/passwd && chown root:root /etc/passwd"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.2"
  file        : "/etc/passwd"
  owner       : "root"
  group       : "root"
  mode        : "644"
  severity    : HIGH
</custom_item>

# 8.2 /etc/shadow İzni 000 veya 640
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.2 /etc/shadow dosya izninin 000 veya 640 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Parola hashleri normal kullanicilar tarafindan okunamaz.
TEHLIKE: Dosya okunursa saldirgan tum sifreleri kirabilir!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 0000 /etc/shadow || chmod 0640 /etc/shadow"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.3"
  file        : "/etc/shadow"
  mask        : "137"
  severity    : HIGH
</custom_item>

# 8.3 /etc/group İzni 644
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.3 /etc/group dosya izninin 644 ve sahibinin root:root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Grup listesini sadece root degistirebilir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 644 /etc/group && chown root:root /etc/group"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.4"
  file        : "/etc/group"
  owner       : "root"
  group       : "root"
  mode        : "644"
  severity    : HIGH
</custom_item>

# 8.4 /etc/gshadow İzni 000 veya 640
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.4 /etc/gshadow dosya izninin 000 veya 640 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Grup parola ozetlerini korur.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 0000 /etc/gshadow || chmod 0640 /etc/gshadow"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.5"
  file        : "/etc/gshadow"
  mask        : "137"
  severity    : HIGH
</custom_item>

# 8.5 /etc/passwd- Yedek Dosya İzni 644 veya 600
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.5 /etc/passwd- yedek dosyasinin izninin 644 veya 600 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Kullanici yedek dosyasini sadece root degistirebilir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 644 /etc/passwd- && chown root:root /etc/passwd-"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.6"
  file        : "/etc/passwd-"
  owner       : "root"
  mask        : "133"
  severity    : MEDIUM
</custom_item>

# 8.6 /etc/shadow- Yedek Dosya İzni 000 veya 600
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "8.6 /etc/shadow- yedek dosyasinin izninin 000 veya 600 oldugunu dogrula"
  info        : "AYARIN ANLAMI: Eski parola hashlerinin yedek dosyasini kimse okuyamaz.
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 0000 /etc/shadow- || chmod 0600 /etc/shadow-"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.7"
  file        : "/etc/shadow-"
  mask        : "177"
  severity    : HIGH
</custom_item>

# 8.7 Sahipsiz (Unowned) Dosyalar Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "8.7 Sistemde sahipsiz (gecersiz UID/GID) dosya bulunmadigini dogrula"
  info        : "AYARIN ANLAMI: Silinmis kullaniciya ait sahipsiz kalmis dosyalarin olmamasidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "find /bin /sbin /usr /etc -xdev \( -nouser -o -nogroup \) -exec chown root:root {} +"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.11"
  cmd         : "find /bin /sbin /usr /etc -xdev \( -nouser -o -nogroup \) 2>/dev/null"
  expect      : "^$"
  severity    : MEDIUM
</custom_item>

# 8.8 Herkese Yazılabilir (World-Writable) Dosyalar Yok
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "8.8 Sistem dizinlerinde herkese yazma yetkili dosya bulunmadigini dogrula"
  info        : "AYARIN ANLAMI: Sistem komut dizinlerinde herhangi bir kullanicinin degistirebilecegi dosya olmamalidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod o-w <dosya_adi>"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.1.10"
  cmd         : "find /etc /usr/bin /usr/sbin -xdev -type f -perm -0002 2>/dev/null"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# 8.9 Root PATH Güvenliği
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "8.9 Root kullanicisinin PATH degiskeninde '.' veya bosluk bulunmadigini dogrula"
  info        : "AYARIN ANLAMI: Root komut arama yolunda gecerli dizin '.' bulunamaz.
TEHLIKE: /tmp altina konulan sahte 'ls' scriptinin root tarafindan kazara calistirilmasini onler!
BULGU SEVIYESI: KRITIK (Critical)
KAPSAM: Tum Linux Sunuculari"
  solution    : "Root PATH tanimindan '.' ve '::' ifadelerini kaldirin."
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.2.4"
  cmd         : "echo $PATH | grep -E '(::|^:|:$|:\.:)'"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# 8.10 Kullanıcı Ev Dizinleri İzinleri (0750 veya 0700)
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "8.10 Kullanici ev dizinlerinin baskalari tarafindan yazilamaz oldugunu dogrula"
  info        : "AYARIN ANLAMI: Bir kullanici baska bir kullanicinin ev dizinine dosya yazamaz.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 750 /home/*"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|6.2.1"
  cmd         : "awk -F: '($3 >= 1000 && $1 != "nobody") {print $6}' /etc/passwd | while read dir; do [ -d "$dir" ] && ls -ld "$dir"; done | awk '$1 ~ /..w$/ {print $9}'"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# 8.11 Kullanıcıların ~/.netrc Dosyalarının Olmaması
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "8.11 Kullanici ev dizinlerinde acik metin parola iceren .netrc dosyasi olmadigini dogrula"
  info        : "AYARIN ANLAMI: .netrc dosyalari FTP vb. sistemler icin duz metin parola tutar. Bulunmamalidir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "rm -f /home/*/.netrc"
  reference   : "800-53|IA-5,CSCv8|5.2,CIS-L1|6.2.12"
  cmd         : "find /home -name '.netrc' 2>/dev/null"
  expect      : "^$"
  severity    : HIGH
</custom_item>

# ==============================================================================
# BÖLÜM 9: ZAMANLANMIŞ GÖREVLER (CRON & AT GÜVENLİĞİ)
# ==============================================================================
# AYARIN AMACI: Arka planda periyodik çalışan görev dosyalarının sadece root
# tarafından yönetilebilmesini sağlamaktır.
# GÜVENLİK RİSKİ: Bir saldırgan cron tablolarına yazma hakkı kazanırsa, dakikalar
# içinde root yetkisiyle ters bağlantı (reverse shell) açar!
# BULGU SEVİYESİ: YÜKSEK (High Severity)
# KAPSAM: Tüm Linux Sunucuları
# ==============================================================================

# 9.1 cron / crond Servisinin Aktif Olması
<custom_item>
  system      : "Linux"
  type        : CMD_EXEC
  description : "9.1 crond veya cron servisinin aktif ve calisir oldugunu dogrula"
  info        : "AYARIN ANLAMI: Periyodik guvenlik gorevleri, log rotasyonlari ve temizlik icin cron aktif olmalidir.
BULGU SEVIYESI: ORTA (Medium)
KAPSAM: Tum Linux Sunuculari"
  solution    : "systemctl enable crond || systemctl enable cron"
  reference   : "800-53|CM-7,CSCv8|4.1,CIS-L1|5.1.1"
  cmd         : "systemctl is-active crond 2>&1 || systemctl is-active cron 2>&1"
  expect      : "^active$"
  severity    : MEDIUM
</custom_item>

# 9.2 /etc/crontab İzni 600
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "9.2 /etc/crontab dosya izninin 600 ve sahibinin root:root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Ana cron dosyasini yalnizca root okuyup yazabilir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 600 /etc/crontab && chown root:root /etc/crontab"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|5.1.2"
  file        : "/etc/crontab"
  owner       : "root"
  group       : "root"
  mask        : "177"
  severity    : HIGH
</custom_item>

# 9.3 /etc/cron.hourly İzni 700
<custom_item>
  system      : "Linux"
  type        : FILE_CHECK
  description : "9.3 /etc/cron.hourly dizin izninin 700 ve sahibinin root oldugunu dogrula"
  info        : "AYARIN ANLAMI: Saatlik calisan gorev dizini sadece root kontrolundedir.
BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "chmod 700 /etc/cron.hourly && chown root:root /etc/cron.hourly"
  reference   : "800-53|AC-6,CSCv8|3.3,CIS-L1|5.1.3"
  file        : "/etc/cron.hourly"
  owner       : "root"
  group       : "root"
  mask        : "077"
  file_type   : "d"
  severity    : HIGH
</custom_item>

