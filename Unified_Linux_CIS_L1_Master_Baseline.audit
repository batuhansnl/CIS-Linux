BULGU SEVIYESI: DUSUK (Low)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'LoginGraceTime 60' >> /etc/ssh/sshd_config"
  reference   : "800-53|AC-12,CSCv8|4.1,CIS-L1|5.2.13"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*LoginGraceTime\s+"
  expect      : "^\s*LoginGraceTime\s+([1-5]?[0-9]|60)\b"
