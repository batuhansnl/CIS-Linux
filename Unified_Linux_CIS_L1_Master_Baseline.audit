BULGU SEVIYESI: YUKSEK (High)
KAPSAM: Tum Linux Sunuculari"
  solution    : "echo 'IgnoreRhosts yes' >> /etc/ssh/sshd_config"
  reference   : "800-53|AC-3,CSCv8|5.2,CIS-L1|5.2.3"
  file        : "/etc/ssh/sshd_config"
  regex       : "^\s*IgnoreRhosts\s+"
  expect      : "^\s*IgnoreRhosts\s+yes\b"
